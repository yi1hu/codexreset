{
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@codexreset/classifier": ["./packages/classifier/src/index.ts"],
      "@codexreset/collectors": ["./packages/collectors/src/index.ts"],
      "@codexreset/db": ["./packages/db/src/index.ts"],
      "@codexreset/domain": ["./packages/domain/src/index.ts"],
      "@codexreset/forecast": ["./packages/forecast/src/index.ts"],
      "@codexreset/shared": ["./packages/shared/src/index.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  }
}
