{
  "name": "codex-reset-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An evidence-first observatory for Codex reset signals and forecasts.",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @codexreset/web build && pnpm --filter @codexreset/worker build",
    "collect:once": "pnpm --filter @codexreset/worker collect:once",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "pnpm --parallel --filter @codexreset/web --filter @codexreset/worker dev",
    "dev:web": "pnpm --filter @codexreset/web dev",
    "dev:worker": "pnpm --filter @codexreset/worker dev",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
